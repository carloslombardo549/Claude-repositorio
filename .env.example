# ============================================================================
# Variables de entorno — Captia
# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
# Si las dejas vacías, la app arranca en MODO DEMO con datos ficticios locales.
# ============================================================================

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anónima (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
