# Galt Signal Engine — variables de entorno
#
# Fase 1 (actual): la app funciona por completo con datos simulados y NO
# requiere ninguna de estas claves. Cópialo a .env.local solo cuando conectes
# integraciones reales en fase 2. Nunca escribas valores reales aquí ni en
# ningún archivo versionado.

# --- Supabase / PostgreSQL (persistencia, fase 2) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplaza-con-tu-clave-anon
SUPABASE_SERVICE_ROLE_KEY=reemplaza-con-tu-clave-service-role

# --- Inngest (jobs programados / radar recurrente, fase 2) ---
INNGEST_EVENT_KEY=reemplaza-con-tu-event-key
INNGEST_SIGNING_KEY=reemplaza-con-tu-signing-key

# --- Apollo.io (enriquecimiento de empresas y decisores, fase 2) ---
APOLLO_API_KEY=reemplaza-con-tu-api-key

# --- Anthropic (generación de mensajes personalizados, fase 2) ---
ANTHROPIC_API_KEY=reemplaza-con-tu-api-key

# --- Proveedor de email para envío de secuencias (fase 2) ---
EMAIL_PROVIDER_API_KEY=reemplaza-con-tu-api-key
EMAIL_PROVIDER_FROM_ADDRESS=ventas@tudominio.com

# --- Flags de producto ---
# Debe permanecer en "false" en todas las fases hasta que exista un proceso
# de aprobación humana verificado en producción para el envío automático.
ENABLE_AUTOMATIC_SENDING=false
